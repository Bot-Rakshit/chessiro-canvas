{
  "name": "chessiro-canvas-native",
  "version": "0.1.0",
  "description": "High-performance chessboard for React Native and Expo. Controlled FEN API, UI-thread drag and move animations (Reanimated), premoves, promotion, arrows, theming — works with chess.js and chessops.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "example:web": "vite --config example-web/vite.config.ts",
    "verify:web": "node example-web/verify.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "chess.js": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^3.19.5",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.0",
    "vite": "^6.4.3"
  },
  "keywords": [
    "chess",
    "chessboard",
    "react-native",
    "expo",
    "reanimated",
    "gesture-handler",
    "chess.js",
    "chessops",
    "fen",
    "premove",
    "drag-and-drop",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://chessiro-canvas.vercel.app/",
  "bugs": {
    "url": "https://github.com/Bot-Rakshit/chessiro-canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bot-Rakshit/chessiro-canvas.git",
    "directory": "native"
  }
}
