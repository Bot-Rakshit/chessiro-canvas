{
  "name": "chessiro-canvas",
  "version": "0.1.46",
  "description": "Fast, lightweight React chessboard component in TypeScript. Zero dependencies, controlled FEN API, drag & drop, arrows, premoves, promotion, theming — works with chess.js and chessops.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "scripts": {
    "pieces:generate": "node scripts/generate-default-piece-svgs.mjs && node scripts/generate-default-piece-data.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "docs:dev": "npm --prefix demo run dev",
    "docs:build": "npm --prefix demo run build",
    "docs:preview": "npm --prefix demo run preview",
    "test": "npm run build && node scripts/test-premove.mjs && node scripts/test-cinematics.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:quick": "npm run build && BENCH_ROUNDS=3 BENCH_WARMUP_ROUNDS=1 BENCH_UPDATES=120 node scripts/benchmark.mjs",
    "benchmark:browser": "node scripts/benchmark-playwright.mjs",
    "benchmark:browser:quick": "BENCH_ROUNDS=3 BENCH_WARMUP_ROUNDS=1 BENCH_UPDATES=120 node scripts/benchmark-playwright.mjs",
    "benchmark:visuals": "npm run build && node scripts/bench-visuals.mjs",
    "benchmark:browser:install": "playwright install chromium",
    "preview:generate": "node scripts/generate-readme-preview.mjs",
    "test:frames": "npm run build && node scripts/test-cinematic-frames.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "react": "^19.0.0",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "chess",
    "chessboard",
    "chess-board",
    "react",
    "react-chessboard",
    "react-component",
    "chess-ui",
    "chessground",
    "chess.js",
    "chessops",
    "fen",
    "pgn",
    "drag-and-drop",
    "premove",
    "chess-analysis",
    "chess-engine-ui",
    "board",
    "lightweight",
    "zero-dependencies",
    "svg",
    "typescript",
    "hooks"
  ],
  "license": "MIT",
  "homepage": "https://chessiro-canvas.vercel.app/",
  "bugs": {
    "url": "https://github.com/Bot-Rakshit/chessiro-canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bot-Rakshit/chessiro-canvas.git"
  }
}
